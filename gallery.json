import os
import json

CONFIG = r"C:\photoboothQR\uploader\config.json"
WEBSITE = r"C:\photoboothQR\website"

with open(CONFIG, "r", encoding="utf-8") as f:
    config = json.load(f)

EVENT = config["event_slug"]

gallery_folder = os.path.join(
    WEBSITE,
    "events",
    EVENT
)

os.makedirs(gallery_folder, exist_ok=True)

gallery_file = os.path.join(
    gallery_folder,
    "gallery.json"
)